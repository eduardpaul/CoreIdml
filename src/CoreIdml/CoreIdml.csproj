<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The core library: package, document model, templates, composition. BCL only, no reflection.
    It runs unchanged on CoreCLR, Native AOT (CoreIdml.Native) and Mono in the browser (CoreIdml.Wasm).
  -->
  <PropertyGroup>
    <RootNamespace>CoreIdml</RootNamespace>
    <CoreIdmlRunsOnMono>true</CoreIdmlRunsOnMono>
    <!-- Turns on the trim, single-file and AOT analyzers; their warnings are build errors. -->
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Not every public member of the document model is documented yet. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <IsPackable>true</IsPackable>
    <PackageId>CoreIdml</PackageId>
    <Description>Read, edit and write Adobe InDesign IDML files without InDesign. Untouched parts are written back byte for byte. No dependencies; trim, Native AOT and WebAssembly safe.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The README shown on nuget.org. -->
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <!-- Blank-document skeleton taken from a real InDesign CS5.5 export (see THIRD-PARTY-NOTICES.md). -->
    <EmbeddedResource Include="Blank\*.xml" LogicalName="CoreIdml.Blank.%(Filename)%(Extension)" />
    <Using Include="CoreIdml.Xml" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CoreIdml.Tests" />
    <!-- The PDF renderer reuses a few document internals (frame thread order, for one) instead of copying them. -->
    <InternalsVisibleTo Include="CoreIdml.Pdf" />
  </ItemGroup>

</Project>
