# Build output of every .NET project, plus the native and wasm builds (see Directory.Build.props)
artifacts/
bin/
obj/
# ...but the launcher of the npm package @coreidml/cli is source
!/bindings/cli/bin/

# Internal working documents (plans, validation records); never published
/docs/internal/

# IDEs
.vs/
.idea/
*.user
*.suo
.vscode/*
!.vscode/extensions.json

# Node
node_modules/
bindings/node/dist/
bindings/wasm/dist/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
bindings/python/build/
bindings/python/dist/
# The native library, copied in only while a platform wheel is built
bindings/python/src/coreidml/_lib/

# Dart
.dart_tool/
pubspec.lock

# What the demos of samples/packages write
/samples/packages/*/out/

# Local test samples that must never be committed
real_samples*/

# OS
.DS_Store
Thumbs.db
docs/reference/*

# InDesign reference samples: internal only, never committed (see tests/doc-samples/TESTING.md).
# The testing guide is the one file kept in git, so it survives when the package is replaced.
/tests/doc-samples/*
!/tests/doc-samples/TESTING.md
# Default output of tools/CoreIdml.VisualReport
/visual-report/
