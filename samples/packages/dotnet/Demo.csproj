<Project Sdk="Microsoft.NET.Sdk">

  <!-- The data sheet template filled with the published CoreIdml and CoreIdml.Pdf packages from nuget.org, on both
       .NET versions the packages support: dotnet run -f net11.0, dotnet run -f net10.0. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CoreIdml.Pdf" Version="1.0.0" />
  </ItemGroup>

</Project>
